# Copy to deploy/compose/.env.rust and replace every CHANGE_ME value.
# Never commit the populated file.

# Pinned data images
POSTGRES_IMAGE=postgres:16.6
REDIS_IMAGE=redis:7.4.2
RABBITMQ_IMAGE=rabbitmq:3.13.7-management
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.8
PROJECT_BALLOON_API_IMAGE=project-balloon-api:0.1.0
PROJECT_BALLOON_JUDGE_IMAGE=project-balloon-judge-worker:0.1.0
PROJECT_BALLOON_WEB_IMAGE=project-balloon-web:0.1.0

# PostgreSQL
POSTGRES_DB=project_balloon
POSTGRES_USER=project_balloon
POSTGRES_PASSWORD=CHANGE_ME_postgres
DATABASE_URL=postgresql://project_balloon:CHANGE_ME_postgres@postgres:5432/project_balloon

# Redis
REDIS_PASSWORD=CHANGE_ME_redis
PROJECT_BALLOON_REALTIME_REDIS_ENABLED=true
REDIS_URL=redis://:CHANGE_ME_redis@redis:6379/0
PROJECT_BALLOON_SCOREBOARD_CACHE_ENABLED=true

# RabbitMQ
RABBITMQ_USER=project_balloon
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
RABBITMQ_VHOST=project_balloon
PROJECT_BALLOON_RABBITMQ_ENABLED=true
PROJECT_BALLOON_RABBITMQ_URL=amqp://project_balloon:CHANGE_ME_rabbitmq@rabbitmq:5672/project_balloon

# RustFS / S3
PROJECT_BALLOON_OBJECT_STORAGE_ENABLED=true
PROJECT_BALLOON_OBJECT_STORAGE_ENDPOINT=http://rustfs:9000
PROJECT_BALLOON_OBJECT_STORAGE_REGION=us-east-1
PROJECT_BALLOON_OBJECT_STORAGE_ACCESS_KEY=project_balloon
PROJECT_BALLOON_OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_rustfs
PROJECT_BALLOON_OBJECT_STORAGE_PROBLEM_BUCKET=project-balloon-problems
PROJECT_BALLOON_OBJECT_STORAGE_SOURCE_BUCKET=project-balloon-sources
# Host-reachable endpoint used by scripts/backup/{backup,restore}.sh.
BACKUP_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000

# API security
PROJECT_BALLOON_CSRF_SECRET=CHANGE_ME_at_least_32_random_bytes
# The bundled endpoint is HTTP. Set this to true only when HTTPS terminates
# in front of Nginx; Secure cookies are not sent over plain HTTP.
PROJECT_BALLOON_SECURE_COOKIES=false
PROJECT_BALLOON_RUN_MIGRATIONS=true

# Judge and web
WORKER_ID=judge-worker-1
DOCKER_GID=999
JUDGE_CACHE_DIR=/var/lib/project-balloon/judge-cache
XCPC_SANDBOX_USER=1000:1000
# Rehearsal defaults to the Docker socket. Production must set these to the
# rootless Podman API socket and `runsc` after installing and validating them.
XCPC_SANDBOX_SOCKET_HOST=/var/run/docker.sock
XCPC_SANDBOX_SOCKET=/var/run/docker.sock
XCPC_SANDBOX_SOCKET_GID=999
XCPC_SANDBOX_RUNTIME=
JUDGE_C_IMAGE=judge-runtime-c:12.2.0
JUDGE_CPP_IMAGE=judge-runtime-cpp:12.2.0
JUDGE_JAVA_IMAGE=judge-runtime-java:21
JUDGE_PYTHON_IMAGE=judge-runtime-python:3.12.13
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8088

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
POSTGRES_EXPORTER_DSN=postgresql://project_balloon:CHANGE_ME_postgres@postgres:5432/project_balloon?sslmode=disable
