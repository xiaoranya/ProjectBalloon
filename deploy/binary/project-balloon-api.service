[Unit]
Description=ProjectBalloon API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@API_USER@
Group=@APP_GROUP@
SupplementaryGroups=@API_SUPPLEMENTARY_GROUPS@
WorkingDirectory=@PREFIX@
EnvironmentFile=@ENV_DIR@/project-balloon.env
ExecStartPre=/usr/bin/test -x @PREFIX@/bin/project-balloon-api
ExecStart=@PREFIX@/bin/project-balloon-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/project-balloon
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
