[Unit]
Description=ProjectBalloon Judge Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@WORKER_USER@
Group=@APP_GROUP@
SupplementaryGroups=@CONTAINER_GROUP@
WorkingDirectory=@PREFIX@
EnvironmentFile=@ENV_DIR@/project-balloon.env
ExecStartPre=/usr/bin/test -x @PREFIX@/bin/project-balloon-judge-worker
ExecStart=@PREFIX@/bin/project-balloon-judge-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@JUDGE_CACHE_DIR@ /var/lib/project-balloon
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
