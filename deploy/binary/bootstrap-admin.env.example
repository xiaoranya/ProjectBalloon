# One-time bootstrap environment. Do not leave the administrator password in
# the shared service environment after bootstrap succeeds.
DATABASE_URL=postgresql://project_balloon:CHANGE_ME_postgres@127.0.0.1:5432/project_balloon
PROJECT_BALLOON_BOOTSTRAP_ADMIN_USERNAME=admin
PROJECT_BALLOON_BOOTSTRAP_ADMIN_DISPLAY_NAME="Platform Administrator"
PROJECT_BALLOON_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_bootstrap_password
