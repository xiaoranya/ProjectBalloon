# API
PROJECT_BALLOON_API_BIND=127.0.0.1:8080
# Set to competition for single-event deployments with workstation pairing.
PROJECT_BALLOON_DEPLOYMENT_MODE=standard
PROJECT_BALLOON_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
RUST_LOG=project_balloon_api=info,project_balloon_judge_worker=info
XCPC_API_PROXY_TARGET=http://127.0.0.1:18080

# PostgreSQL development defaults only; replace all contest credentials.
# Set deployment-specific database credentials; there is no credentialed default.
DATABASE_URL=
PROJECT_BALLOON_BOOTSTRAP_ADMIN_USERNAME=admin
PROJECT_BALLOON_BOOTSTRAP_ADMIN_DISPLAY_NAME="Platform Administrator"
PROJECT_BALLOON_BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-password
PROJECT_BALLOON_OBJECT_STORAGE_ENABLED=false
PROJECT_BALLOON_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
PROJECT_BALLOON_OBJECT_STORAGE_REGION=us-east-1
PROJECT_BALLOON_OBJECT_STORAGE_ACCESS_KEY=change-this-access-key
PROJECT_BALLOON_OBJECT_STORAGE_SECRET_KEY=change-this-secret-key
PROJECT_BALLOON_OBJECT_STORAGE_PROBLEM_BUCKET=xcpc-problems
PROJECT_BALLOON_OBJECT_STORAGE_SOURCE_BUCKET=xcpc-sources
PROJECT_BALLOON_OBJECT_STORAGE_FORCE_PATH_STYLE=true
PROJECT_BALLOON_OBJECT_STORAGE_REQUEST_TIMEOUT_MILLISECONDS=5000
PROJECT_BALLOON_RABBITMQ_ENABLED=false
PROJECT_BALLOON_RABBITMQ_URL=
PROJECT_BALLOON_RABBITMQ_REQUEST_TIMEOUT_MILLISECONDS=5000
PROJECT_BALLOON_JUDGE_DISPATCH_POLL_MILLISECONDS=500
PROJECT_BALLOON_JUDGE_DISPATCH_LEASE_SECONDS=30
PROJECT_BALLOON_JUDGE_DISPATCH_RETRY_BASE_MILLISECONDS=1000
PROJECT_BALLOON_JUDGE_DISPATCH_BATCH_SIZE=50
PROJECT_BALLOON_JUDGE_DISPATCH_MAX_ATTEMPTS=8
PROJECT_BALLOON_JUDGE_RESULT_PREFETCH=32
PROJECT_BALLOON_JUDGE_RESULT_RECONNECT_MILLISECONDS=1000
PROJECT_BALLOON_DATABASE_MAX_CONNECTIONS=20
PROJECT_BALLOON_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5
PROJECT_BALLOON_READINESS_TIMEOUT_MILLISECONDS=1000
PROJECT_BALLOON_RUN_MIGRATIONS=true

# Browser authentication development defaults only.
# Production must use HTTPS, secure cookies, and an independently generated secret.
PROJECT_BALLOON_SESSION_TTL_SECONDS=43200
PROJECT_BALLOON_SECURE_COOKIES=false
# The built-in secret is public and must never be used outside local
# development. Startup refuses to run with it unless this opt-in is set.
PROJECT_BALLOON_ALLOW_DEV_CSRF_SECRET=true
PROJECT_BALLOON_CSRF_SECRET=development-only-csrf-secret-change-me

# Realtime outbox + SSE.
PROJECT_BALLOON_REALTIME_DISPATCHER_ENABLED=true
PROJECT_BALLOON_REALTIME_CHANNEL_CAPACITY=1024
PROJECT_BALLOON_REALTIME_POLL_MILLISECONDS=250
PROJECT_BALLOON_REALTIME_LEASE_SECONDS=30
PROJECT_BALLOON_REALTIME_RETRY_BASE_MILLISECONDS=1000
PROJECT_BALLOON_REALTIME_BATCH_SIZE=100
PROJECT_BALLOON_REALTIME_MAX_ATTEMPTS=8
# Enable on every API replica in multi-instance deployments.
PROJECT_BALLOON_REALTIME_REDIS_ENABLED=false
# Set a Redis URL with ACL credentials when Redis features are enabled.
REDIS_URL=
PROJECT_BALLOON_REALTIME_REDIS_CHANNEL=xcpc:realtime:events
PROJECT_BALLOON_REALTIME_REDIS_RECONNECT_MILLISECONDS=1000
PROJECT_BALLOON_SCOREBOARD_CACHE_ENABLED=false
PROJECT_BALLOON_SCOREBOARD_CACHE_TTL_SECONDS=30
PROJECT_BALLOON_SCOREBOARD_CACHE_TIMEOUT_MILLISECONDS=200

# Durable object cleanup and storage reconciliation.
PROJECT_BALLOON_OBJECT_CLEANUP_POLL_MILLISECONDS=5000
PROJECT_BALLOON_OBJECT_CLEANUP_LEASE_SECONDS=30
PROJECT_BALLOON_OBJECT_CLEANUP_RETRY_BASE_MILLISECONDS=1000
PROJECT_BALLOON_OBJECT_CLEANUP_BATCH_SIZE=50

# Optional CUPS printing.
PROJECT_BALLOON_CUPS_ENABLED=false
PROJECT_BALLOON_CUPS_PRINTER=xcpc
PROJECT_BALLOON_CUPS_COMMAND_TIMEOUT_MILLISECONDS=5000

# Judge worker bootstrap
WORKER_ID=worker-local
JUDGE_CACHE_DIR=/var/cache/judge
JUDGE_TASK_QUEUE=judge.tasks
JUDGE_TASK_PREFETCH=1
JUDGE_RECONNECT_MILLISECONDS=1000
JUDGE_HEARTBEAT_INTERVAL_SECONDS=5
JUDGE_REQUEST_TIMEOUT_MILLISECONDS=10000
JUDGE_MAX_ARTIFACT_BYTES=314572800
XCPC_SANDBOX_SOCKET=/var/run/docker.sock
# Production must set runsc; leave empty only for the documented local Docker profile.
XCPC_SANDBOX_RUNTIME=
XCPC_SANDBOX_USER=1000:1000
JUDGE_C_IMAGE=judge-runtime-c:12.2.0
JUDGE_CPP_IMAGE=judge-runtime-cpp:12.2.0
JUDGE_JAVA_IMAGE=judge-runtime-java:21
JUDGE_PYTHON_IMAGE=judge-runtime-python:3.12.13
